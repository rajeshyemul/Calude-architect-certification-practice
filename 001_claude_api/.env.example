# Standard Anthropic API Key (if using official Anthropic API):
# ANTHROPIC_API_KEY="your-api-key-here"

# For running against local Ollama via LiteLLM proxy:
ANTHROPIC_API_KEY="sk-litellm-master-key"
LITELLM_MASTER_KEY="sk-litellm-master-key"
LITELLM_DANGEROUSLY_PERMIT_WEAK_OR_UNSET_MASTER_KEY="true"
ANTHROPIC_BASE_URL="http://localhost:4000"
ANTHROPIC_MODEL="ollama/llama3.2"
